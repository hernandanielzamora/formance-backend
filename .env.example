NODE_ENV=development
PORT=4200
FRONTEND_ORIGIN=http://localhost:3000
# Nuevo proyecto de Formance. Nunca usar el proyecto de Nutrivo.
FIREBASE_PROJECT_ID=
# Ruta local al JSON de cuenta de servicio, relativo a esta carpeta o absoluto.
# Ejemplo: ./credentials/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# FoodData Central: clave gratuita, solo backend.
USDA_API_KEY=
# Google AI Studio: usar una clave de un proyecto SIN facturacion (Free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Cupos propios conservadores. No habilitan ni cambian la facturacion de Google.
FOOD_AI_USER_DAILY_LIMIT=3
FOOD_AI_GLOBAL_DAILY_LIMIT=20
FOOD_AI_GLOBAL_MINUTE_LIMIT=3
